{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ActiveInferenceInstitute/AEOS/schema/aeos.schema.json",
  "title": "Active Entity Ontology for Science",
  "type": "object",
  "required": [
    "schema_version",
    "ontology",
    "entity_classes",
    "entity_types",
    "areas_of_concern",
    "roles",
    "affordances",
    "states",
    "relationships",
    "motifs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ontology": {"$ref": "#/$defs/ontology"},
    "entity_classes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/entityClass"}},
    "entity_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entityType"}},
    "areas_of_concern": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/area"}},
    "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}},
    "affordances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/affordance"}},
    "states": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/state"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "motifs": {"type": "array", "items": {"$ref": "#/$defs/motif"}},
    "source": {"type": "string", "minLength": 1},
    "graph": {"$ref": "#/$defs/graph"},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1},
    "idList": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "ontology": {
      "type": "object",
      "required": ["id", "version", "title", "description", "license", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "aeos"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "license": {"const": "CC-BY-4.0"},
        "provenance": {
          "type": "object",
          "required": ["publication", "doi", "interactive_source", "source_accessed"],
          "additionalProperties": false,
          "properties": {
            "publication": {"$ref": "#/$defs/text"},
            "doi": {"type": "string", "format": "uri"},
            "interactive_source": {"type": "string", "format": "uri"},
            "source_accessed": {"type": "string", "format": "date"}
          }
        }
      }
    },
    "entityClass": {
      "type": "object", "required": ["id", "label", "description"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}}
    },
    "entityType": {
      "type": "object", "required": ["id", "label", "class", "description"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "class": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"}}
    },
    "area": {
      "type": "object", "required": ["id", "label", "description"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}}
    },
    "role": {
      "type": "object", "required": ["id", "label", "description", "entity_types", "affordances"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "entity_types": {"$ref": "#/$defs/idList"}, "affordances": {"$ref": "#/$defs/idList"}}
    },
    "affordance": {
      "type": "object", "required": ["id", "label", "description", "areas", "actors", "targets", "objects"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "areas": {"$ref": "#/$defs/idList"}, "actors": {"$ref": "#/$defs/idList"}, "targets": {"$ref": "#/$defs/idList"}, "objects": {"$ref": "#/$defs/idList"}}
    },
    "state": {
      "type": "object", "required": ["id", "label", "kind", "description"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "kind": {"enum": ["internal", "sense", "active"]}, "description": {"$ref": "#/$defs/text"}}
    },
    "relationship": {
      "type": "object", "required": ["id", "source", "relation", "target", "description"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "relation": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"}}
    },
    "step": {
      "type": "object", "required": ["sequence", "actor", "affordance", "target"], "additionalProperties": false,
      "properties": {"sequence": {"type": "integer", "minimum": 1}, "actor": {"$ref": "#/$defs/id"}, "affordance": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"}, "object": {"$ref": "#/$defs/id"}}
    },
    "motif": {
      "type": "object", "required": ["id", "label", "area", "context", "description", "steps"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "area": {"$ref": "#/$defs/id"}, "context": {"enum": ["cesci", "desci"]}, "description": {"$ref": "#/$defs/text"}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}}
    },
    "graph": {
      "type": "object", "required": ["nodes", "edges"], "additionalProperties": false,
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/graphNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/graphEdge"}}
      }
    },
    "graphNode": {
      "type": "object", "required": ["id", "label", "type"], "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "type": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}}
    },
    "graphEdge": {
      "type": "object", "required": ["source", "target", "relation"], "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "relation": {"$ref": "#/$defs/text"},
        "id": {"$ref": "#/$defs/id"},
        "motif": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "object": {"$ref": "#/$defs/id"}
      }
    },
    "summary": {
      "type": "object", "required": ["class_count", "type_count", "area_count", "role_count", "affordance_count", "state_count", "relationship_count", "motif_count", "graph_node_count", "graph_edge_count"], "additionalProperties": false,
      "properties": {
        "class_count": {"type": "integer", "minimum": 0},
        "type_count": {"type": "integer", "minimum": 0},
        "area_count": {"type": "integer", "minimum": 0},
        "role_count": {"type": "integer", "minimum": 0},
        "affordance_count": {"type": "integer", "minimum": 0},
        "state_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "motif_count": {"type": "integer", "minimum": 0},
        "graph_node_count": {"type": "integer", "minimum": 0},
        "graph_edge_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
